<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">


        <!-- Background atas -->
        <ImageView
            android:id="@+id/imgHomeBackground"
            android:layout_width="0dp"
            android:layout_height="500dp"
            android:contentDescription="Pemandangan Labuan Bajo"
            android:scaleType="centerCrop"
            android:src="@drawable/bg_home_labuanbajo"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- gradasiiii -->
        <View
            android:layout_width="0dp"
            android:layout_height="430dp"
            android:background="#55001D35"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            android:fontFamily="@font/inter"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Toolbar -->
        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="0dp"
            android:layout_height="?attr/actionBarSize"
            android:elevation="12dp"
            app:theme="@style/ThemeOverlay.AppCompat.Dark.ActionBar"
            app:titleTextColor="#FFFFFF"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:popupTheme="@style/KomooraPopupMenu"/>

        <!-- hai user -->
        <TextView
            android:id="@+id/tvHello"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="28dp"
            android:layout_marginTop="70dp"
            android:text="Hello Lindi,"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Judul -->
        <TextView
            android:id="@+id/tvDiscoverTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="28dp"
            android:layout_marginTop="12dp"
            android:layout_marginEnd="20dp"
            android:text="Discover Cool&#10;Places"
            android:textColor="#FFFFFF"
            android:textSize="36sp"
            android:fontFamily="@font/montserrat_bold"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvHello" />

        <!-- Kolom pencarian -->
        <LinearLayout
            android:id="@+id/searchContainer"
            android:layout_width="0dp"
            android:layout_height="66dp"
            android:layout_marginStart="28dp"
            android:layout_marginTop="24dp"
            android:layout_marginEnd="28dp"
            android:background="@drawable/bg_home_search"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:fontFamily="@font/inter"
            android:paddingStart="14dp"
            android:paddingEnd="20dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvDiscoverTitle">


            <EditText
                android:id="@+id/etSearchDestination"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@null"
                android:drawableStart="@drawable/ic_search"
                android:drawableTint="#0D3A84"
                android:drawablePadding="8dp"
                android:hint="Where To?"
                android:importantForAutofill="no"
                android:inputType="text"
                android:paddingStart="16dp"
                android:singleLine="true"
                android:textColor="#333333"
                android:textColorHint="#999999"
                android:textSize="18sp" />

        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- sheet bawah ini :D -->
    <ScrollView
            android:id="@+id/scrollHome"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="0dp"
            android:background="@drawable/bg_home_panel"
            android:clipToPadding="false"
            android:fillViewport="false"
            android:overScrollMode="never"
            android:paddingTop="28dp"
            android:layout_gravity="bottom"
            app:layout_behavior="@string/bottom_sheet_behavior"
            app:behavior_peekHeight="340dp"
            app:behavior_fitToContents="false"
            app:behavior_halfExpandedRatio="0.65"
            app:behavior_expandedOffset="0dp"
            app:behavior_hideable="false">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="24dp"
                android:paddingEnd="24dp"
                android:paddingBottom="24dp">

                <!-- Handle panel -->
                <View
                    android:layout_width="52dp"
                    android:layout_height="4dp"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginBottom="28dp"
                    android:background="#BDBDBD" />



                <!-- Kategori -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center"
                    android:baselineAligned="false">

                    <!-- Nature -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:orientation="vertical">

                        <ImageButton
                            android:id="@+id/btnNature"
                            android:layout_width="64dp"
                            android:layout_height="64dp"
                            android:background="@drawable/bg_category_circle"
                            android:src="@drawable/ic_nature"
                            android:scaleType="fitCenter"
                            android:padding="18dp"
                            android:contentDescription="Nature"
                            app:tint="#FFFFFF" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:text="Nature"
                            android:fontFamily="@font/inter"
                            android:textColor="#0D3A84"
                            android:textSize="12sp"
                            android:singleLine="true" />
                    </LinearLayout>

                    <!-- Hotel -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:orientation="vertical">

                        <ImageButton
                            android:id="@+id/btnHotel"
                            android:layout_width="64dp"
                            android:layout_height="64dp"
                            android:background="@drawable/bg_category_circle"
                            android:src="@drawable/ic_hotel"
                            android:scaleType="fitCenter"
                            android:padding="18dp"
                            android:contentDescription="Hotel"
                            app:tint="#FFFFFF" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:text="Hotel"
                            android:fontFamily="@font/inter"
                            android:textColor="#0D3A84"
                            android:textSize="12sp"
                            android:singleLine="true" />
                    </LinearLayout>

                    <!-- Culinary -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:orientation="vertical">

                        <ImageButton
                            android:id="@+id/btnCulinary"
                            android:layout_width="64dp"
                            android:layout_height="64dp"
                            android:background="@drawable/bg_category_circle"
                            android:src="@drawable/ic_culinary"
                            android:scaleType="fitCenter"
                            android:padding="18dp"
                            android:contentDescription="Culinary"
                            app:tint="#FFFFFF" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:text="Culinary"
                            android:textColor="#0D3A84"
                            android:textSize="12sp"
                            android:fontFamily="@font/inter"
                            android:singleLine="true" />
                    </LinearLayout>

                    <!-- Culture -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:orientation="vertical">

                        <ImageButton
                            android:id="@+id/btnCulture"
                            android:layout_width="64dp"
                            android:layout_height="64dp"
                            android:background="@drawable/bg_category_circle"
                            android:src="@drawable/ic_culture"
                            android:scaleType="fitCenter"
                            android:padding="18dp"
                            android:contentDescription="Culture"
                            app:tint="#FFFFFF" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:text="Culture"
                            android:fontFamily="@font/inter"
                            android:textColor="#0D3A84"
                            android:textSize="12sp"
                            android:singleLine="true" />
                    </LinearLayout>

                    <!-- Souvenir -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:orientation="vertical">

                        <ImageButton
                            android:id="@+id/btnSouvenir"
                            android:layout_width="64dp"
                            android:layout_height="64dp"
                            android:background="@drawable/bg_category_circle"
                            android:src="@drawable/ic_souvenir"
                            android:scaleType="fitCenter"
                            android:padding="18dp"
                            android:contentDescription="Souvenir"
                            app:tint="#FFFFFF" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:text="Souvenir"
                            android:textColor="#0D3A84"
                            android:textSize="12sp"
                            android:fontFamily="@font/inter"
                            android:singleLine="true" />
                    </LinearLayout>

                </LinearLayout>



                <!-- Judul Popular Destination -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="42dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Popular Destination"
                        android:textColor="#0D3A84"
                        android:fontFamily="@font/montserrat_bold"
                        android:textSize="24sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="See Details  ›"
                        android:textColor="#777777"
                        android:textSize="15sp" />

                </LinearLayout>

                <!-- CardView Labuan Bajo -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/cardLabuanBajo"
                    android:layout_width="match_parent"
                    android:layout_height="210dp"
                    android:layout_marginTop="12dp"
                    app:cardCornerRadius="24dp"
                    app:cardElevation="6dp"
                    app:cardUseCompatPadding="false">

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent">

                        <ImageView
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:contentDescription="Destinasi Labuan Bajo"
                            android:scaleType="centerCrop"
                            android:src="@drawable/recommend_labuan_bajo" />

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="#44000000" />

                        <ImageButton
                            android:id="@+id/btnFavoriteLabuanBajo"
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:layout_gravity="top|end"
                            android:layout_margin="8dp"
                            android:background="@android:color/transparent"
                            android:src="@drawable/ic_heart"
                            android:padding="8dp"
                            android:contentDescription="Tambahkan ke favorit"
                            android:scaleType="fitCenter"
                            app:tint="#808080" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_gravity="bottom"
                            android:orientation="vertical"
                            android:padding="16dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Labuan Bajo"
                                android:textColor="#FFFFFF"
                                android:fontFamily="@font/montserrat_bold"
                                android:textSize="25sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Manggarai Barat"
                                android:textColor="#FFFFFF"
                                android:fontFamily="@font/inter"
                                android:textSize="16sp" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="end"
                                android:text="★  4.8 (1.2k)"
                                android:fontFamily="@font/inter"
                                android:textColor="#FFFFFF"
                                android:textSize="14sp"
                                android:textStyle="bold" />

                        </LinearLayout>

                    </FrameLayout>

                </androidx.cardview.widget.CardView>

                <!-- Judul rekomendasi -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="34dp"
                    android:text="Our Recommendation"
                    android:textColor="#0D3A84"
                    android:fontFamily="@font/montserrat_bold"
                    android:textSize="24sp"
                    android:textStyle="bold" />

                <!-- Daftar rekomendasi horizontal -->
                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="190dp"
                    android:layout_marginTop="12dp"
                    android:scrollbars="none">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:orientation="horizontal">

                        <!-- Komodo Island -->
                        <androidx.cardview.widget.CardView
                            android:layout_width="260dp"
                            android:layout_height="180dp"
                            android:layout_marginEnd="14dp"
                            app:cardCornerRadius="18dp"
                            app:cardElevation="4dp">

                            <FrameLayout
                                android:layout_width="match_parent"
                                android:layout_height="match_parent">

                                <ImageView
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:contentDescription="Pulau Komodo"
                                    android:scaleType="centerCrop"
                                    android:src="@drawable/recommend_komodo" />

                                <View
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:background="#44000000" />

                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_gravity="bottom"
                                    android:orientation="vertical"
                                    android:padding="12dp">

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="Komodo Island"
                                        android:textColor="#FFFFFF"
                                        android:fontFamily="@font/inter"
                                        android:textSize="18sp"
                                        android:textStyle="bold" />

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="Manggarai Barat  ★ 4.8"
                                        android:textColor="#FFFFFF"
                                        android:fontFamily="@font/inter"
                                        android:textSize="12sp" />

                                </LinearLayout>

                            </FrameLayout>

                        </androidx.cardview.widget.CardView>

                        <!-- Bolok Crystal Cave -->
                        <androidx.cardview.widget.CardView
                            android:layout_width="260dp"
                            android:layout_height="180dp"
                            android:layout_marginEnd="14dp"
                            app:cardCornerRadius="18dp"
                            app:cardElevation="4dp">

                            <FrameLayout
                                android:layout_width="match_parent"
                                android:layout_height="match_parent">

                                <ImageView
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:contentDescription="Bolok Crystal Cave"
                                    android:scaleType="centerCrop"
                                    android:src="@drawable/recommend_cave" />

                                <View
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:background="#44000000" />

                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_gravity="bottom"
                                    android:orientation="vertical"
                                    android:padding="12dp">

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="Bolok Crystal Cave"
                                        android:textColor="#FFFFFF"
                                        android:fontFamily="@font/montserrat_bold"
                                        android:textSize="18sp"
                                        android:textStyle="bold" />

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="Kupang Barat  ★ 4.8"
                                        android:textColor="#FFFFFF"
                                        android:fontFamily="@font/inter"
                                        android:textSize="12sp" />

                                </LinearLayout>

                            </FrameLayout>

                        </androidx.cardview.widget.CardView>

                        <!-- oenesu waterfall-->
                        <androidx.cardview.widget.CardView
                            android:layout_width="260dp"
                            android:layout_height="180dp"
                            app:cardCornerRadius="18dp"
                            app:cardElevation="4dp">

                            <FrameLayout
                                android:layout_width="match_parent"
                                android:layout_height="match_parent">

                                <ImageView
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:contentDescription="Air terjun di NTT"
                                    android:scaleType="centerCrop"
                                    android:src="@drawable/recommend_waterfall" />

                                <View
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:background="#44000000" />

                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_gravity="bottom"
                                    android:orientation="vertical"
                                    android:padding="12dp">

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="Oenesu Waterfall"
                                        android:textColor="#FFFFFF"
                                        android:fontFamily="@font/montserrat_bold"
                                        android:textSize="18sp"
                                        android:textStyle="bold" />

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="Manggarai Barat  ★ 4.8"
                                        android:textColor="#FFFFFF"
                                        android:fontFamily="@font/inter"
                                        android:textSize="12sp" />

                                </LinearLayout>

                            </FrameLayout>

                        </androidx.cardview.widget.CardView>

                    </LinearLayout>

                </HorizontalScrollView>

            </LinearLayout>

    </ScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
