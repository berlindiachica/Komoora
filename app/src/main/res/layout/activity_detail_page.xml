<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF">

    <!-- Foto utama Labuan Bajo -->
    <ImageView
        android:id="@+id/imgDetailBackground"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:contentDescription="Pemandangan Labuan Bajo"
        android:scaleType="centerCrop"
        android:src="@drawable/labuan_bajo"
        app:layout_constraintHeight_percent="0.60"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Lapisan gelap pada foto -->
    <View
        android:id="@+id/detailImageOverlay"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="#22001D35"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="@id/imgDetailBackground"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Tombol Back -->
    <TextView
        android:id="@+id/tvBack"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginTop="36dp"
        android:padding="8dp"
        android:text="‹  Back"
        android:textColor="#FFFFFF"
        android:textSize="18sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Tombol favorit -->
    <TextView
        android:id="@+id/tvFavorite"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginTop="30dp"
        android:layout_marginEnd="24dp"
        android:gravity="center"
        android:text="♥"
        android:textColor="#F51E2D"
        android:textSize="34sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Panel informasi putih -->
    <ScrollView
        android:id="@+id/detailPanel"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@drawable/bg_detail_panel"
        android:clipToPadding="false"
        android:fillViewport="false"
        android:overScrollMode="never"
        app:layout_constraintTop_toBottomOf="@id/imgDetailBackground"
        app:layout_constraintBottom_toTopOf="@id/detailBottomNavigation"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingTop="16dp"
            android:paddingEnd="24dp"
            android:paddingBottom="24dp">

            <!-- Handle panel -->
            <View
                android:layout_width="52dp"
                android:layout_height="4dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginBottom="28dp"
                android:background="#BDBDBD" />

            <!-- Nama destinasi dan harga -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvDestinationName"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Labuan Bajo"
                    android:textColor="#0D3A84"
                    android:textSize="32sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tvPrice"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="$ 40"
                        android:textColor="#0D3A84"
                        android:textSize="22sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="/person"
                        android:textColor="#6682B0"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                </LinearLayout>

            </LinearLayout>

            <!-- Lokasi -->
            <TextView
                android:id="@+id/tvLocation"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Manggarai Barat"
                android:textColor="#0D3A84"
                android:textSize="20sp" />

            <!-- Rating -->
            <TextView
                android:id="@+id/tvRating"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="★ 4.8 (1.2k)"
                android:textColor="#0D3A84"
                android:textSize="23sp"
                android:textStyle="bold" />

            <!-- Deskripsi -->
            <TextView
                android:id="@+id/tvDescription"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:justificationMode="inter_word"
                android:lineSpacingExtra="3dp"
                android:text="Labuan Bajo merupakan salah satu destinasi wisata unggulan di Nusa Tenggara Timur. Tempat ini terkenal dengan pemandangan laut yang indah, gugusan pulau yang menawan, serta perairan biru yang jernih. Wisatawan dapat menikmati keindahan Pulau Padar, mengunjungi habitat komodo, menjelajahi pantai, dan menikmati matahari terbenam. Labuan Bajo juga menjadi titik awal perjalanan untuk menjelajahi berbagai pulau di sekitarnya."
                android:textColor="#383838"
                android:textSize="17sp" />

        </LinearLayout>

    </ScrollView>

    <!-- Navigasi bawah -->
    <LinearLayout
        android:id="@+id/detailBottomNavigation"
        android:layout_width="0dp"
        android:layout_height="68dp"
        android:background="#FFFFFF"
        android:elevation="8dp"
        android:gravity="center"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/navHome"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="⌂"
            android:textColor="#777777"
            android:textSize="34sp" />

        <TextView
            android:id="@+id/navSearch"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="⌕"
            android:textColor="#777777"
            android:textSize="32sp" />

        <TextView
            android:id="@+id/navCalendar"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="▦"
            android:textColor="#777777"
            android:textSize="30sp" />

        <TextView
            android:id="@+id/navFavorite"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="♡"
            android:textColor="#777777"
            android:textSize="32sp" />

        <TextView
            android:id="@+id/navProfile"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="♙"
            android:textColor="#777777"
            android:textSize="30sp" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
