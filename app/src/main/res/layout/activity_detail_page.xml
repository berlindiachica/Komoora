<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF">

    <!-- Foto utama destinasi -->
    <ImageView
        android:id="@+id/imgDetailBackground"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:contentDescription="Pemandangan Labuan Bajo"
        android:scaleType="centerCrop"
        android:src="@drawable/recommend_labuan_bajo"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/detailPanel"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHeight_percent="0.52" />

    <!-- Overlay foto -->
    <View
        android:id="@+id/detailImageOverlay"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="#16001D35"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/detailPanel"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Tombol Back -->
    <ImageView
        android:id="@+id/tvBack"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginStart="20dp"
        android:layout_marginTop="28dp"
        android:background="@drawable/bg_detail_back_button"
        android:padding="12dp"
        android:src="@drawable/ic_back"
        android:scaleType="fitCenter"
        android:contentDescription="Kembali"
        app:tint="#FFFFFF"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Tombol favorit -->
    <ImageView
        android:id="@+id/tvFavorite"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginTop="28dp"
        android:layout_marginEnd="20dp"
        android:background="@drawable/bg_detail_favorite_button"
        android:padding="10dp"
        android:src="@drawable/ic_heart"
        android:scaleType="fitCenter"
        android:contentDescription="Tambahkan ke favorit"
        app:tint="#F04452"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Panel informasi dengan sudut atas membulat -->
    <ScrollView
        android:id="@+id/detailPanel"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@drawable/bg_detail_panel"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:elevation="8dp"
        android:overScrollMode="never"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintVertical_bias="1"
        app:layout_constraintHeight_percent="0.57">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingTop="18dp"
            android:paddingEnd="24dp"
            android:paddingBottom="32dp">

            <!-- Handle panel -->
            <View
                android:layout_width="52dp"
                android:layout_height="5dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginBottom="28dp"
                android:background="@drawable/bg_detail_handle" />

            <!-- Nama destinasi dan harga -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvDestinationName"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Labuan Bajo"
                    android:fontFamily="@font/montserrat_bold"
                    android:textColor="#0D3A84"
                    android:textSize="29sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="end"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvPrice"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="$ 40"
                        android:textColor="#0D3A84"
                        android:fontFamily="@font/inter"
                        android:textSize="23sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="/person"
                        android:textColor="#777777"
                        android:fontFamily="@font/inter"
                        android:textSize="13sp" />

                </LinearLayout>
            </LinearLayout>

            <!-- Lokasi -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:contentDescription="Lokasi"
                    android:src="@drawable/ic_location"
                    android:scaleType="fitCenter"
                    app:tint="#1685DB" />

                <TextView
                    android:id="@+id/tvLocation"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:fontFamily="@font/inter"
                    android:text="Manggarai Barat, Nusa Tenggara Timur"
                    android:textColor="#777777"
                    android:textSize="15sp" />

            </LinearLayout>

            <!-- Rating -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:background="@drawable/bg_detail_rating"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="14dp"
                android:paddingTop="8dp"
                android:paddingEnd="14dp"
                android:paddingBottom="8dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="★"
                    android:textColor="#FFB800"
                    android:textSize="25sp" />

                <TextView
                    android:id="@+id/tvRating"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:text="4.8"
                    android:textColor="#0D3A84"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:fontFamily="@font/inter" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:text="(1.2k)"
                    android:textColor="#777777"
                    android:fontFamily="@font/inter"
                    android:textSize="16sp" />

            </LinearLayout>

            <!-- Deskripsi -->
            <TextView
                android:id="@+id/tvDescription"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:lineSpacingExtra="4dp"
                android:text="Labuan Bajo merupakan salah satu destinasi wisata unggulan di Nusa Tenggara Timur. Tempat ini terkenal dengan pemandangan laut yang indah, gugusan pulau yang menawan, serta perairan biru yang jernih. Wisatawan dapat menikmati keindahan Pulau Padar, mengunjungi habitat komodo, menjelajahi pantai, dan menikmati matahari terbenam. Labuan Bajo juga menjadi titik awal perjalanan untuk menjelajahi berbagai pulau di sekitarnya."
                android:textColor="#505563"
                android:fontFamily="@font/inter"
                android:textSize="16sp" />

        </LinearLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>