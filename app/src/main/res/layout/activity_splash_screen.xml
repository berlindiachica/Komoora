<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF">

    <View
        android:id="@+id/viewSplashCurve"
        android:layout_width="520dp"
        android:layout_height="520dp"
        android:background="@drawable/bg_splash_curve"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.504"
        app:layout_constraintStart_toStartOf="parent" />

    <View
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:background="@drawable/bg_splash_dot"
        android:layout_marginStart="40dp"
        android:layout_marginTop="100dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <View
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:background="@drawable/bg_splash_dot"
        android:layout_marginTop="70dp"
        android:layout_marginEnd="55dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <View
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:background="@drawable/bg_splash_dot"
        android:layout_marginTop="200dp"
        android:layout_marginStart="160dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- Logo Komoora -->
    <ImageView
        android:id="@+id/ivLogo"
        android:layout_width="270dp"
        android:layout_height="180dp"
        android:layout_marginTop="60dp"
        android:contentDescription="Logo Komoora"
        android:scaleType="fitCenter"
        android:src="@drawable/komoora_logo"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.567"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />


    <ImageView
        android:id="@+id/ivPadar"
        android:layout_width="250dp"
        android:layout_height="420dp"
        android:layout_marginStart="4dp"
        android:layout_marginBottom="-40dp"
        android:background="@drawable/bg_splash_photo"
        android:clipToOutline="true"
        android:contentDescription="Wisata Pulau pantai pink"
        android:elevation="4dp"
        android:rotation="-2"
        android:scaleType="centerCrop"
        android:src="@drawable/splash_papink"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <ImageView
        android:id="@+id/ivKomodo"
        android:layout_width="250dp"
        android:layout_height="420dp"
        android:layout_marginStart="92dp"
        android:layout_marginBottom="4dp"
        android:background="@drawable/bg_splash_photo"
        android:clipToOutline="true"
        android:contentDescription="Wisata Pulau Komodo"
        android:elevation="8dp"
        android:rotation="5"
        android:scaleType="centerCrop"
        android:src="@drawable/splash_komodo"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <ImageView
        android:id="@+id/ivLabuanBajo"
        android:layout_width="260dp"
        android:layout_height="450dp"
        android:layout_marginEnd="-80dp"
        android:layout_marginBottom="-40dp"
        android:background="@drawable/bg_splash_photo"
        android:clipToOutline="true"
        android:contentDescription="Wisata Labuan Bajo"
        android:elevation="12dp"
        android:rotation="12"
        android:scaleType="centerCrop"
        android:src="@drawable/splash_labuan_bajo"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />
</androidx.constraintlayout.widget.ConstraintLayout>